<Window x:Class="WarehouseManagement_Oshchepkov.WPF.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="620" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование:" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="1" Margin="5" Padding="8,5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ед. измерения:" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="TxtUnit" Grid.Row="1" Grid.Column="1" Margin="5" Text="шт" Padding="8,5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Категория:" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="CmbCategory" Grid.Row="2" Grid.Column="1" Margin="5" 
                  DisplayMemberPath="Name" SelectedValuePath="Id" Padding="8,5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Производитель:" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="CmbManufacturer" Grid.Row="3" Grid.Column="1" Margin="5" 
                  DisplayMemberPath="Name" SelectedValuePath="Id" Padding="8,5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Поставщик:" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="CmbSupplier" Grid.Row="4" Grid.Column="1" Margin="5" 
                  DisplayMemberPath="Name" SelectedValuePath="Id" Padding="8,5"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Цена (₽):" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="TxtPrice" Grid.Row="5" Grid.Column="1" Margin="5" Padding="8,5"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Скидка (%):" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="TxtDiscount" Grid.Row="6" Grid.Column="1" Margin="5" Text="0" Padding="8,5"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Остаток:" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="TxtStockQuantity" Grid.Row="7" Grid.Column="1" Margin="5" Text="0" Padding="8,5"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Описание:" FontWeight="Bold" 
                   VerticalAlignment="Top" Margin="5"/>
        <TextBox x:Name="TxtDescription" Grid.Row="8" Grid.Column="1" Margin="5" 
                 Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,5"/>
        
        <Separator Grid.Row="9" Grid.ColumnSpan="2" Margin="0,15" 
                   Background="{StaticResource BorderBrush}"/>

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnOk" Content="Сохранить" Width="100" Height="32"
                    Margin="0,0,10,0" Click="BtnOk_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="Отмена" Width="80" Height="32"
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="WarehouseManagement_Oshchepkov.WPF.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление товарами" Height="600" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ТОВАРЫ" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#3D3D40" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="TxtContextOrg" FontSize="14" FontWeight="Bold"/>
                <TextBlock x:Name="TxtContextWarehouse" FontSize="14" FontWeight="Bold" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <Button x:Name="BtnAdd" Content="Добавить товар" Width="120" Click="BtnAdd_Click"/>
            <Button x:Name="BtnEdit" Content="Редактировать" Width="120" Click="BtnEdit_Click"/>
            <Button x:Name="BtnDelete" Content="Удалить" Width="100" Click="BtnDelete_Click"/>
            <Button x:Name="BtnImport" Content="Импорт CSV" Width="110" Click="BtnImport_Click"/>
            <Button x:Name="BtnInvoiceIn" Content="Приход" Width="100" Click="BtnInvoiceIn_Click" Background="#4CAF50"/>
            <Button x:Name="BtnInvoiceOut" Content="Расход" Width="100" Click="BtnInvoiceOut_Click" Background="#FFA000"/>
        </StackPanel>

        <ListView x:Name="LvProducts" Grid.Row="3">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Артикул" Width="80" DisplayMemberBinding="{Binding Article}"/>
                    <GridViewColumn Header="Наименование" Width="180" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Категория" Width="100" DisplayMemberBinding="{Binding Category.Name}"/>
                    <GridViewColumn Header="Производитель" Width="120" DisplayMemberBinding="{Binding Manufacturer.Name}"/>
                    <GridViewColumn Header="Поставщик" Width="140" DisplayMemberBinding="{Binding SupplierName}"/>
                    <GridViewColumn Header="Цена" Width="80" DisplayMemberBinding="{Binding Price, StringFormat={}{0:N0}₽}"/>
                    <GridViewColumn Header="Остаток" Width="70" DisplayMemberBinding="{Binding StockQuantity}"/>
                    <GridViewColumn Header="Скидка" Width="70" DisplayMemberBinding="{Binding DiscountPercent}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnBack" Content="Назад к складам" Width="150" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>
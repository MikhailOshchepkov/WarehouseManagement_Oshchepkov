<Window x:Class="WarehouseManagement_Oshchepkov.WPF.WarehousesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление складами" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="СКЛАДЫ" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#3D3D40" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <TextBlock x:Name="TxtOrganizationInfo" FontSize="14" FontWeight="Bold" 
                       Foreground="#FFA500" TextAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <Button x:Name="BtnAdd" Content="Добавить склад" Width="120" Click="BtnAdd_Click"/>
            <Button x:Name="BtnEdit" Content="Редактировать" Width="120" Click="BtnEdit_Click"/>
            <Button x:Name="BtnDelete" Content="Удалить" Width="100" Click="BtnDelete_Click"/>
        </StackPanel>

        <ListView x:Name="LvWarehouses" Grid.Row="3" 
                  MouseDoubleClick="LvWarehouses_MouseDoubleClick"
                  SelectionChanged="LvWarehouses_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="60" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Название склада" Width="250" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Адрес" Width="250" DisplayMemberBinding="{Binding Address}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnBack" Content="Назад к организациям" Width="180" Click="BtnBack_Click"/>
            <Button x:Name="BtnSelect" Content="Выбрать склад" Width="150" Click="BtnSelect_Click" Background="#4CAF50"/>
        </StackPanel>
    </Grid>
</Window>